---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/articles/TableOfContents.astro";
import { formatDate } from "../lib/utils";

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: number;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, publishedDate, updatedDate, tags, readingTime, headings } = Astro.props;
---

<BaseLayout title={`${title} — Faris Bayu Setyawan`} description={description}>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_220px]">
    <article class="min-w-0">
      <div class="sheet">
        <header class="border-b border-[var(--border-on-card)] pb-6">
          <p class="eyebrow" style="color: var(--accent-on-light)">$ cat article.md</p>
          <h1
            class="mt-3 font-display text-3xl uppercase leading-[1.05] tracking-[0.02em] sm:text-4xl"
            style="color: var(--text-on-card)"
          >
            {title}
          </h1>
          <p class="mt-3 text-[15px] font-light leading-relaxed" style="color: var(--text-on-card-muted)">
            {description}
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[10px] uppercase tracking-[0.14em]" style="color: var(--text-on-card-muted)">
            <span>{formatDate(publishedDate)}</span>
            <span aria-hidden="true">·</span>
            <span>{readingTime} min read</span>
            {updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>updated {formatDate(updatedDate)}</span>
              </>
            )}
          </div>
          {
            tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <span class="p-tag p-tag--accent"><span>#{tag}</span></span>
                ))}
              </div>
            )
          }
        </header>

        <div class="prose article-prose mt-8 max-w-none">
          <slot />
        </div>
      </div>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>
