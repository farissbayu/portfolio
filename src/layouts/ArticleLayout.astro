---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/articles/TableOfContents.astro";
import { formatDate } from "../lib/utils";

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: number;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, publishedDate, updatedDate, tags, readingTime, headings } = Astro.props;
---

<BaseLayout title={`${title} — Faris Bayu Setyawan`} description={description}>
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_220px]">
    <article class="min-w-0">
      <header class="border-b border-zinc-800/80 pb-8">
        <p class="font-mono text-[11px] text-matcha-300">$ cat article.md</p>
        <h1 class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
          {title}
        </h1>
        <p class="mt-4 text-base font-light leading-relaxed text-zinc-400">{description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[11px] text-zinc-400">
          <span>{formatDate(publishedDate)}</span>
          <span class="text-zinc-500">·</span>
          <span>{readingTime} min read</span>
          {updatedDate && (
            <>
              <span class="text-zinc-500">·</span>
              <span>updated {formatDate(updatedDate)}</span>
            </>
          )}
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          {tags.map((tag) => <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-matcha-300">#{tag}</span>)}
        </div>
      </header>

      <div
        class="prose prose-invert prose-zinc mt-10 max-w-none prose-headings:font-display prose-headings:tracking-tight prose-a:text-matcha-300 prose-a:no-underline hover:prose-a:underline prose-strong:text-zinc-100 prose-code:font-mono prose-code:text-matcha-300 prose-pre:border prose-pre:border-zinc-800/80 prose-pre:bg-zinc-900/60 prose-blockquote:border-matcha-700"
      >
        <slot />
      </div>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-28">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>
