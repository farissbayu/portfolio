---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Not Found" description="The requested page could not be found.">
  <section class="flex min-h-[60vh] flex-col items-start justify-center">
    <p class="eyebrow">System message</p>
    <h1 class="hero__name mt-2">Game <em>over</em></h1>
    <p class="hero__lede">
      This path doesn&rsquo;t exist. The save file is intact — head back to the title screen.
    </p>
    <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
      bash: /requested_path: no such file<span class="cursor-blink text-accent">▋</span>
    </p>
    <a href="/" class="p-btn mt-6"><span>Back to start</span></a>
  </section>
</BaseLayout>
