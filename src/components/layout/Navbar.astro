---
const links = [
  { id: "about", label: "about" },
  { id: "work", label: "work" },
  { id: "projects", label: "projects" },
  { id: "articles", label: "articles" },
  { id: "contact", label: "contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-hairline/60 surface-sunken backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5" aria-label="Primary">
    <a href="/" class="group flex items-baseline gap-1 font-mono text-sm text-strong">
      <span class="font-semibold">FB</span><span class="text-accent group-hover:text-accent-deep">.</span>
    </a>

    <ul class="hidden items-center gap-6 md:flex">
      {
        links.map((link, i) => (
          <li>
            <a
              href={`/#${link.id}`}
              data-nav
              data-section={link.id}
              class="font-mono text-[11px] uppercase tracking-[0.18em] text-body transition-colors hover:text-accent"
            >
              <span class="text-faint">[{String(i + 1).padStart(2, "0")}/]</span>{link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md border border-hairline p-2 text-body transition-colors hover:accent-border-strong hover:text-accent"
        aria-label="Toggle color theme"
        title="Toggle color theme"
      >
        <svg id="icon-sun" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg id="icon-moon" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="rounded-md border border-hairline p-2 text-body transition-colors hover:accent-border-strong hover:text-accent md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block h-px w-5 bg-current"></span>
        <span class="mt-1.5 block h-px w-5 bg-current"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="border-t border-hairline/60 surface-sunken px-6 py-4 md:hidden">
    <ul class="flex flex-col gap-4">
      {
        links.map((link, i) => (
          <li>
            <a
              href={`/#${link.id}`}
              data-nav
              data-section={link.id}
              class="font-mono text-xs uppercase tracking-[0.18em] text-body transition-colors hover:text-accent"
            >
              <span class="text-faint">[{String(i + 1).padStart(2, "0")}/]</span>{link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<div id="scroll-progress" class="fixed inset-x-0 top-0 z-[60] h-px accent-solid"></div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    if (menu) menu.hidden = expanded;
  });

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      if (menu) menu.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
    })
  );

  const progress = document.getElementById("scroll-progress");
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav]"));
  const sections = navLinks
    .map((l) => document.getElementById(l.dataset.section || ""))
    .filter((el): el is HTMLElement => Boolean(el));

  const onScroll = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    if (progress) progress.style.width = `${max > 0 ? (doc.scrollTop / max) * 100 : 0}%`;

    let current = "";
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= 120) current = section.id;
    }
    navLinks.forEach((link) => {
      const active = link.dataset.section === current;
      link.setAttribute("aria-current", active ? "true" : "false");
      link.classList.toggle("text-accent", active);
    });
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Smooth-scroll to sections without leaving a `#hash` in the URL.
  navLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const id = link.dataset.section;
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      event.preventDefault();
      if (menu) menu.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
      target.scrollIntoView({ behavior: "smooth", block: "start" });
      history.replaceState(null, "", window.location.pathname + window.location.search);
    });
  });

  // Strip any incoming `#hash` once the browser has jumped to the target.
  if (window.location.hash) {
    const stripHash = () =>
      history.replaceState(null, "", window.location.pathname + window.location.search);
    window.addEventListener("load", () => setTimeout(stripHash, 0), { once: true });
    setTimeout(stripHash, 100);
  }

  const themeToggle = document.getElementById("theme-toggle");
  const iconSun = document.getElementById("icon-sun");
  const iconMoon = document.getElementById("icon-moon");

  const syncThemeIcons = () => {
    const light = document.documentElement.dataset.theme === "light";
    iconSun?.classList.toggle("hidden", !light);
    iconMoon?.classList.toggle("hidden", light);
  };

  themeToggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    syncThemeIcons();
  });

  syncThemeIcons();
</script>
