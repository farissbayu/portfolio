---
import { personal_information } from "../../lib/portfolio";

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-hairline">
  <div
    class="mx-auto flex max-w-[1180px] flex-col gap-2 px-6 py-6 font-mono text-[10px] uppercase tracking-[0.16em] text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {personal_information.name}</p>
    <div class="flex flex-wrap items-center gap-4">
      <a
        href={`mailto:${personal_information.email}`}
        class="inline-flex min-h-11 min-w-11 items-center transition-colors hover:text-accent md:min-h-0 md:min-w-0"
      >
        email
      </a>
      <a
        href={personal_information.linkedin}
        target="_blank"
        rel="noreferrer"
        class="inline-flex min-h-11 items-center transition-colors hover:text-accent md:min-h-0"
      >
        linkedin
      </a>
      <span class="text-faint">Made in Malang</span>
    </div>
  </div>
</footer>
