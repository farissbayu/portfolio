---
import { personal_information } from "../../lib/portfolio";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-hairline/60">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs text-body">
      © {year} {personal_information.name}
    </p>
    <div class="flex flex-wrap items-center gap-4 font-mono text-[11px]">
      <a href={`mailto:${personal_information.email}`} class="text-body transition-colors hover:text-accent">
        email
      </a>
      <a
        href={personal_information.linkedin}
        target="_blank"
        rel="noreferrer"
        class="text-body transition-colors hover:text-accent"
      >
        linkedin
      </a>
    </div>
  </div>
</footer>
