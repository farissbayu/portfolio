---
import { getSectionLinks } from "../../lib/sections";
import { personal_information } from "../../lib/portfolio";

const links = await getSectionLinks();
const pad = (n: number) => String(n).padStart(2, "0");
---

<nav class="rail" aria-label="Slides">
  <a href="/" class="rail__mark">
    <span class="rail__badge">FBS</span>
    <span class="meta" style="line-height:1.5">Product<br />Engineer</span>
  </a>

  <ol class="rail__nav">
    {
      links.map((link, i) => (
        <li>
          <a
            href={`/#${link.id}`}
            data-nav
            data-section={link.id}
            data-deck-link={link.id}
            class="rail__link"
          >
            <span class="rail__num" aria-hidden="true">{pad(i + 1)}</span>
            <span>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="rail__meta">
    <span>Player · <b>{personal_information.name}</b></span>
    <span>Location · <b>{personal_information.location}, ID</b></span>
  </div>

  <span class="rail__flag"><i></i>Open to work</span>

  <div class="rail__tools">
    <button
      type="button"
      data-theme-toggle
      class="icon-btn"
      aria-label="Switch to light theme"
      title="Switch to light theme"
    >
      <svg
        data-icon-sun
        class="hidden h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg
        data-icon-moon
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
    </button>
  </div>
</nav>
