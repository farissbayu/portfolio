---
import { getSectionLinks } from "../../lib/sections";

const links = await getSectionLinks();
---

<header class="topbar">
  <a href="/" class="topbar__brand">
    <span class="brand-badge">FB</span>
    <span class="meta hidden sm:block" style="line-height:1.5">Product<br />Engineer</span>
  </a>

  <nav class="topbar__nav" aria-label="Primary">
    {
      links.map((link) => (
        <a href={`/#${link.id}`} data-nav data-section={link.id} class="topbar__link">
          {link.label}
        </a>
      ))
    }
  </nav>

  <div style="display:flex;align-items:center;gap:0.5rem;margin-left:auto">
    <button
      type="button"
      data-theme-toggle
      class="icon-btn"
      aria-label="Switch to light theme"
      title="Switch to light theme"
    >
      <svg
        data-icon-sun
        class="hidden h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg
        data-icon-moon
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
    </button>

    <button
      id="menu-toggle"
      type="button"
      class="icon-btn menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu" hidden class="mobile-menu">
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={`/#${link.id}`} data-nav data-section={link.id}>
            <span class="text-accent">›</span>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
