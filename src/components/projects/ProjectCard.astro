---
import type { Project } from "../../types/portfolio";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(3, "0");
---

<article class="p-card project">
  <span class="p-card__tab">No. {num}</span>

  <h3 class="project__title">
    {
      project.link ? (
        <a href={project.link} target="_blank" rel="noopener noreferrer">
          {project.name} ↗
        </a>
      ) : (
        project.name
      )
    }
  </h3>
  <p class="project__role">{project.role}</p>
  <p class="project__body">{project.description}</p>

  <ul class="project__details">
    {project.responsibilities.map((item) => <li>{item}</li>)}
  </ul>

  <div class="project__tags">
    {project.technologies.map((tech) => <span class="p-tag p-tag--dark"><span>{tech}</span></span>)}
  </div>

  <div class="project__go">
    <span>{project.link ? "Live site" : "Case file"}</span>
    <span aria-hidden="true">↗</span>
  </div>
</article>
