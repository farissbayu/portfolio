---
import type { CollectionEntry } from "astro:content";
import { formatDate, readingTime } from "../../lib/utils";

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const { title, description, publishedDate, tags } = entry.data;
const minutes = entry.body ? readingTime(entry.body) : 1;
---

<a href={`/articles/${entry.id}/`} class="p-card flex flex-col gap-2 p-5">
  <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.14em]">
    <span>{formatDate(publishedDate)}</span>
    <span>{minutes} min read</span>
  </div>

  <h3 class="project__title">{title}</h3>
  <p class="project__body flex-1">{description}</p>

  <div class="mt-2 flex flex-wrap gap-1.5">
    {tags.map((tag) => <span class="p-tag p-tag--dark"><span>#{tag}</span></span>)}
  </div>
</a>
