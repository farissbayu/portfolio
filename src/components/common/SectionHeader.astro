---
interface Props {
  index: string;
  title: string;
  eyebrow?: string;
  meta?: string;
}

const { index, title, eyebrow, meta } = Astro.props;
---

<div class="sec-head reveal">
  <div class="sec-head__title">
    <span class="sec-head__num">{index}</span>
    <div>
      {eyebrow && <span class="sec-head__eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
    </div>
  </div>
  {meta && <span class="meta hidden sm:block">{meta}</span>}
</div>
