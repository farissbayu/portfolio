---
interface Props {
  label: string;
  accent?: boolean;
}

const { label, accent = false } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded border px-2 py-0.5 font-mono text-[11px] transition-colors",
    accent
      ? "border-matcha-800/60 bg-matcha-950/40 text-matcha-300 hover:border-matcha-600 hover:text-matcha-200"
      : "border-zinc-800 bg-zinc-900/40 text-zinc-400 hover:border-matcha-700 hover:text-matcha-300",
  ]}
>
  {label}
</span>
