---
interface Props {
  label: string;
  accent?: boolean;
}

const { label, accent = false } = Astro.props;
---

<span
  class:list={[
    "pill-hover inline-flex items-center rounded border px-2 py-0.5 font-mono text-[11px]",
    accent
      ? "accent-border accent-surface text-accent hover:accent-border-strong hover:text-accent-strong"
      : "border-hairline surface-raised text-body hover:accent-border-strong hover:text-accent",
  ]}
>
  {label}
</span>
