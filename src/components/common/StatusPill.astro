---
interface Props {
  label?: string;
}

const { label = "Open to full-time fullstack & AI roles" } = Astro.props;
---

<span
  class="inline-flex w-fit items-center gap-2.5 border accent-border surface-raised px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-accent"
>
  <span class="relative flex h-2 w-2">
    <span class="signal-ping"></span>
    <span class="signal-dot relative inline-flex h-2 w-2 rounded-full"></span>
  </span>
  {label}
</span>
