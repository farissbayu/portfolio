---
interface Props {
  label?: string;
}

const { label = "Available for select engineering opportunities" } = Astro.props;
---

<span
  class="inline-flex items-center gap-2.5 rounded-full border accent-border surface-raised px-3.5 py-1.5 font-mono text-[11px] text-accent"
>
  <span class="relative flex h-2 w-2">
    <span class="pulse-ring absolute inline-flex h-full w-full rounded-full bg-signal-400/70"></span>
    <span class="relative inline-flex h-2 w-2 rounded-full bg-signal-400"></span>
  </span>
  {label}
</span>
