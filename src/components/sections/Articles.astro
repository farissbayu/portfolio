---
import { getCollection } from "astro:content";
import SectionHeader from "../common/SectionHeader.astro";
import ArticleCard from "../articles/ArticleCard.astro";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 3);
---

{
  articles.length > 0 && (
    <section id="articles" class="reveal scroll-mt-24">
      <SectionHeader index="04" title="articles" meta={`[ ${articles.length} recent ]`} />
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {articles.map((entry) => (
          <ArticleCard entry={entry} />
        ))}
      </div>
      <div class="mt-8">
        <a
          href="/articles/"
          class="font-mono text-[11px] text-zinc-400 transition-colors hover:text-matcha-300"
        >
          $ ls ./articles <span class="text-matcha-300">→</span>
        </a>
      </div>
    </section>
  )
}
