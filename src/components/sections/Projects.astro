---
import SectionHeader from "../common/SectionHeader.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { projects } from "../../lib/portfolio";
---

<section id="projects" class="reveal">
  <SectionHeader
    index="III"
    title="Projects"
    eyebrow="palaces"
    meta={`[ ${projects.length} entries ]`}
  />
  <div class="cards-3 stagger reveal">
    {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
  </div>
</section>
