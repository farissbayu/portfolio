---
import SectionHeader from "../common/SectionHeader.astro";
import ContactForm from "../islands/ContactForm.tsx";
import CopyButton from "../islands/CopyButton.tsx";
import { personal_information } from "../../lib/portfolio";
---

<section id="contact" class="reveal scroll-mt-24">
  <SectionHeader index="07" title="contact" meta="[ let's build ]" />

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <p class="text-sm font-light leading-relaxed text-zinc-400">
        Open to fullstack and AI/LLM engineering work. The fastest way to reach me is email — or use
        the form and I will get back to you.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${personal_information.email}`}
          class="font-mono text-xs text-matcha-300 transition-colors hover:text-matcha-200"
        >
          {personal_information.email}
        </a>
        <CopyButton client:visible value={personal_information.email} />
      </div>
      <dl class="mt-8 space-y-3 font-mono text-[11px]">
        <div class="flex gap-3">
          <dt class="w-20 text-zinc-400">location</dt>
          <dd class="text-zinc-400">{personal_information.location}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 text-zinc-400">phone</dt>
          <dd class="text-zinc-400">{personal_information.phone}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 text-zinc-400">linkedin</dt>
          <dd>
            <a
              href={personal_information.linkedin}
              target="_blank"
              rel="noreferrer"
              class="text-zinc-400 transition-colors hover:text-matcha-300"
            >
              /in/faris-bayu-setyawan
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/30 p-6 sm:p-8">
      <ContactForm client:visible />
    </div>
  </div>
</section>
