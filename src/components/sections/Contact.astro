---
import SectionHeader from "../common/SectionHeader.astro";
import CopyButton from "../islands/CopyButton.tsx";
import { personal_information } from "../../lib/portfolio";
---

<section id="contact" class="reveal">
  <SectionHeader index="VII" title="Contact" eyebrow="the house awaits" meta="[ let's build ]" />

  <div class="contact-band">
    <div>
      <p class="contact-band__k">The heist is recruiting</p>
      <h2>Take your time.</h2>
      <p>
        Open to fullstack and AI/LLM engineering work. Email is the fastest route — usually answered
        within one working day.
      </p>
    </div>

    <div class="contact-band__acts">
      <a class="p-btn" href={`mailto:${personal_information.email}`}>
        <span>{personal_information.email}</span>
      </a>
      <a
        class="p-btn p-btn--ghost"
        href={personal_information.linkedin}
        target="_blank"
        rel="noreferrer"
      ><span>LinkedIn ↗</span></a>
      <CopyButton client:visible value={personal_information.email} />
    </div>
  </div>

  <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1 font-mono text-[10px] uppercase tracking-[0.14em] text-muted">
    <span>Location · {personal_information.location}, ID</span>
    <span>Availability · Full-time</span>
    <span>Timezone · GMT+7</span>
  </div>
</section>
