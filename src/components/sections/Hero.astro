---
import { Image } from "astro:assets";
import photo from "../../assets/photo_profile.jpeg";
import StatusPill from "../common/StatusPill.astro";
import {
  personal_information,
  profile,
  work_experience,
  projects,
  education,
  certifications,
} from "../../lib/portfolio";

const roles = ["Fullstack Developer", "AI/LLM Integration", "React · Laravel · FastAPI"];

const stats = [
  { value: String(work_experience.length).padStart(2, "0"), label: "Roles held" },
  { value: String(projects.length).padStart(2, "0"), label: "Projects shipped" },
  { value: education[0]?.gpa ?? "—", label: "GPA" },
  { value: String(certifications.length).padStart(2, "0"), label: "Certifications" },
];
---

<section id="about" class="reveal">
  <StatusPill />

  <div class="hero mt-6">
    <div>
      <span class="eyebrow">Calling card · Product engineer</span>
      <h1 class="hero__name">Faris Bayu <em>Setyawan</em></h1>

      <div class="mt-4 flex flex-wrap gap-2">
        {roles.map((role) => <span class="p-tag"><span>{role}</span></span>)}
      </div>

      <p class="hero__lede">{profile}</p>

      <div class="hero__cta">
        <a class="p-btn" href={`mailto:${personal_information.email}`}><span>Email me</span></a>
        <a
          class="p-btn p-btn--ghost"
          href={personal_information.linkedin}
          target="_blank"
          rel="noreferrer"
        ><span>LinkedIn ↗</span></a>
        <span class="hero__where">{personal_information.location}, ID · GMT+7</span>
      </div>
    </div>

    <aside class="portrait hero__portrait">
      <div class="portrait__dots" aria-hidden="true"></div>
      <div class="portrait__frame">
        <Image
          src={photo}
          alt={`Portrait of ${personal_information.name}`}
          widths={[320, 640]}
          sizes="(max-width: 1024px) 100vw, 330px"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full object-cover"
        />
      </div>
      <span class="portrait__slab">Player 01</span>
      <span class="portrait__stamp">Available for full-time</span>
    </aside>
  </div>

  <div class="stat-strip">
    {
      stats.map((stat) => (
        <div>
          <b>{stat.value}</b>
          <span>{stat.label}</span>
        </div>
      ))
    }
  </div>
</section>
