---
import SectionHeader from "../common/SectionHeader.astro";
import { education, certifications, achievements } from "../../lib/portfolio";
---

<section id="education" class="reveal">
  <SectionHeader
    index="VI"
    title="Education & awards"
    eyebrow="record"
    meta="[ academic & credentials ]"
  />

  <div class="rows reveal">
    {
      education.map((entry, i) => (
        <article class="row">
          <div class="row__meta">
            <b>{String(i + 1).padStart(2, "0")}</b>
            <span>{entry.period}</span>
            <span>{entry.location}</span>
            {entry.gpa && <span class="text-accent">GPA {entry.gpa}</span>}
          </div>
          <div class="min-w-0">
            <h3 class="row__title">{entry.institution}</h3>

            {entry.cohorts ? (
              <ul class="mt-2 grid gap-2">
                {entry.cohorts.map((cohort) => (
                  <li class="border-l border-hairline pl-3">
                    <p class="text-[13px] text-body">{cohort.program}</p>
                    <p class="meta">{cohort.period}</p>
                    {cohort.details && (
                      <ul class="row__list">
                        {cohort.details.map((detail) => (
                          <li>{detail}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <>
                <p class="row__body">{entry.degree ?? entry.program}</p>
                {entry.details && (
                  <ul class="row__list">
                    {entry.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                )}
              </>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <div class="border border-hairline surface-raised p-4">
      <p class="meta text-accent">Certifications</p>
      <ul class="mt-2 grid gap-2">
        {
          certifications.map((cert) => (
            <li class="flex items-baseline justify-between gap-3">
              <div class="min-w-0">
                <p class="text-[13px] leading-snug text-body">{cert.name}</p>
                <p class="meta">{cert.issuer}</p>
              </div>
              <span class="meta shrink-0">{cert.year}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="border border-hairline surface-raised p-4">
      <p class="meta text-accent">Achievements</p>
      <ul class="mt-2 grid gap-2">
        {
          achievements.map((item) => (
            <li class="flex items-baseline justify-between gap-3">
              <div class="min-w-0">
                <p class="text-[13px] leading-snug text-body">{item.title}</p>
                <p class="meta">{item.role} · {item.technology}</p>
              </div>
              <span class="meta shrink-0">{item.year}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
