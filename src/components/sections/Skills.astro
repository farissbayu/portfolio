---
import SectionHeader from "../common/SectionHeader.astro";
import { skills } from "../../lib/portfolio";

const groups = [
  { key: "frontend", label: "Frontend" },
  { key: "backend", label: "Backend" },
  { key: "database", label: "Database" },
  { key: "ai_and_llm", label: "AI / LLM" },
  { key: "infrastructure", label: "Infra" },
] as const;
---

<section id="skills" class="reveal">
  <SectionHeader index="IV" title="Skills" eyebrow="codex" meta="[ equipped ]" />

  <div class="skills stagger reveal">
    {
      groups.map((group) => (
        <div class="skill">
          <h3>{group.label}</h3>
          <ul>
            {skills[group.key].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
