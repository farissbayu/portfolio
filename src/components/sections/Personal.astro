---
import { Image } from "astro:assets";
import SectionHeader from "../common/SectionHeader.astro";
import personal from "../../data/personal.json";
import replay from "../../data/apple-music.json";

const { playlist, topArtists } = replay;
const year = playlist.title.match(/\d{4}/)?.[0] ?? "";
const ranked = topArtists.slice(0, 6);

// Optional cover art: drop a file into src/assets/personal/ and name it in
// personal.json. Missing files fall back to a text-only card.
const art = import.meta.glob<ImageMetadata>("/src/assets/personal/*.{jpg,jpeg,png,webp}", {
  eager: true,
  import: "default",
});
const artFor = (file?: string) => {
  if (!file) return undefined;
  const image = art[`/src/assets/personal/${file}`];
  if (!image) console.warn(`[personal] missing cover art: src/assets/personal/${file}`);
  return image;
};
---

<section id="personal" class="reveal">
  <SectionHeader
    index="VII"
    title="Personal"
    eyebrow="off the clock"
    meta={`[ updated ${personal.updated} ]`}
  />

  <div class="now-rack">
    {
      personal.now.map((item) => {
        const image = artFor(item.image);
        return (
          <article class="now-card">
            {image && (
              <Image
                src={image}
                alt=""
                width={240}
                height={240}
                class="now-card__art"
                style={`object-position: ${item.focus ?? "50% 50%"}`}
              />
            )}
            <div class="now-card__body">
              <span class="now-card__kind">{item.status}</span>
              <h3 class="now-card__title">{item.title}</h3>
              <p class="now-card__note">{item.note}</p>
            </div>
          </article>
        );
      })
    }
  </div>

  {
    ranked.length > 0 && (
      <div class="listen-grid">
        <div class="listen-frame">
          <iframe
            title={`Apple Music — Replay ${year}`}
            class="block h-full w-full"
            allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
            sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
            src={playlist.embedUrl}
            loading="lazy"
          />
        </div>

        <div>
          <p class="eyebrow">Top artists — from replay {year}</p>
          <p class="mt-2 max-w-[42ch] text-[13px] font-light leading-relaxed text-body">
            Ranked by how many tracks made it into this year&rsquo;s Replay, so it tracks what actually
            got repeat plays.
          </p>

          <ol class="mt-4 border-t border-hairline">
            {ranked.map((artist, index) => (
              <li>
                <a
                  href={artist.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="artist-row"
                >
                  <span class="w-5 shrink-0 font-mono text-[9px] text-accent">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <img
                    src={artist.image}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-10 shrink-0 object-cover"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[13px] font-medium text-strong">
                      {artist.name}
                    </span>
                    <span class="block truncate font-mono text-[9px] text-muted">
                      {artist.topTrack.title}
                    </span>
                  </span>
                  <span class="shrink-0 font-mono text-[9px] text-muted">
                    <span class="text-accent">×{artist.tracks}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>

          <a
            href={playlist.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex min-h-11 items-center font-mono text-[10px] uppercase tracking-[0.16em] text-body transition-colors hover:text-accent md:min-h-0"
          >
            open replay {year} <span class="ml-1 text-accent">↗</span>
          </a>
        </div>
      </div>
    )
  }
</section>
